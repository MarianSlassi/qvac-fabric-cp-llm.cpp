#version 450

layout(local_size_x = 1) in;

layout(push_constant) uniform P {
    uint n_dim;
    uint n_head;
    uint n_block;
    uint block_size;
    uint nb_k1, nb_k2, nb_k3;
    uint nb_d1, nb_d2, nb_d3;
} p;

layout(binding = 0) buffer K { float data[]; } k;
layout(binding = 1) buffer D { float data[]; } d;

void main() {
    const uint ir = gl_GlobalInvocationID.x;
    const uint ib = ir % p.n_block;
    const uint ih = (ir / p.n_block) % p.n_head;
    const uint is = ir / (p.n_block * p.n_head);

    const uint out_base = ih*(p.nb_d1/4) + ib*(p.nb_d2/4) + is*(p.nb_d3/4);
    for (uint dd = 0; dd < p.n_dim; ++dd) d.data[out_base + dd] = 0.0;
    for (uint j = 0; j < p.block_size; ++j) {
        const uint base = ih*(p.nb_k1/4) + (ib*p.block_size + j)*(p.nb_k2/4) + is*(p.nb_k3/4);
        for (uint dd = 0; dd < p.n_dim; ++dd) d.data[out_base + dd] += k.data[base + dd];
    }
    for (uint dd = 0; dd < p.n_dim; ++dd) d.data[out_base + dd] /= float(p.block_size);
}
